{
  "name": "@vocalcord/openclaw-plugin",
  "version": "0.1.0",
  "description": "OpenClaw plugin: registers Vocal Cord's MCP server, opens a webhook receiver (or WebSocket fallback) for real-time inbound messages, and runs a 6-hourly pull-sync for pull-style channels.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VocalCord/vocalcord-client.git",
    "directory": "clients/openclaw-plugin"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "lib",
    "binding.js",
    "binding.d.ts",
    "openclaw.plugin.json",
    "README.md"
  ],
  "openclaw": {
    "extensions": ["./dist/index.js"]
  },
  "scripts": {
    "build:rust": "napi build --platform --release",
    "build:rust:debug": "napi build --platform",
    "build:ts": "tsc",
    "build": "npm run build:rust:debug && npm run build:ts",
    "watch:ts": "tsc -w",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vocalcord/sdk": "file:../../../vocalcord/sdk/typescript"
  },
  "peerDependenciesMeta": {
    "openclaw": { "optional": true }
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  },
  "napi": {
    "name": "vocalcord-openclaw-plugin",
    "triples": {
      "defaults": false,
      "additional": [
        "x86_64-apple-darwin",
        "aarch64-apple-darwin",
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
        "x86_64-pc-windows-msvc"
      ]
    }
  }
}
